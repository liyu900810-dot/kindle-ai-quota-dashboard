{
  "outputDir": "state",
  "keepLocalHistory": false,
  "quoteFile": "config/quote.json",
  "weatherFile": "",
  "weatherPlace": "Yangzhou",
  "weatherLabel": "扬州",
  "todo": {
    "provider": "file",
    "file": "config/todo.json",
    "fallbackFile": "config/todo.json",
    "maxItems": 5,
    "notion": {
      "tokenEnv": "NOTION_API_KEY",
      "dataSourceIdEnv": "NOTION_DATA_SOURCE_ID",
      "titleProperty": "任务",
      "statusProperty": "状态",
      "dueProperty": "截止日期",
      "priorityProperty": "优先级",
      "visibleProperty": "Kindle显示",
      "doneValues": ["完成", "已完成", "Done", "Completed"]
    }
  },
  "providers": {
    "deepseek": {
      "enabled": false,
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "claude": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.claude/.credentials.json"
    },
    "codex": {
      "enabled": false,
      "experimental": true,
      "executableEnv": "CODEX_CLI_PATH"
    },
    "kimi": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.kimi-code/credentials/kimi-code.json",
      "baseUrl": "https://api.kimi.com/coding/v1"
    }
  }
}
